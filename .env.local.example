# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key: server-only, never expose to the browser.
# Used by scripts/seed.mjs, scripts/bootstrap-super-admin.mjs, and any
# privileged server-side operation (invitations, cross-tenant admin reads).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to build the email-invitation redirect link for admins/instructors.
# Set to your real deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SUPER_ADMIN bootstrap (section 2) — run `npm run bootstrap-admin` once.
# Never hardcode these; the script is a no-op if a super_admin already exists.
# ---------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_INITIAL_PASSWORD=change-me-to-a-strong-password-12+chars

# ---------------------------------------------------------------------------
# Social login (section 3) — NOT YET CONFIGURED. Configure the matching
# provider in Supabase Dashboard > Authentication > Providers with these same
# credentials; the login/signup UI only shows a provider button once Supabase
# reports it as enabled. Leave unset to keep email/password-only auth.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Mobile Money payment provider (section 14) — NOT YET CONFIGURED. The app's
# payment abstraction (lib/payments/provider.ts) already models
# pending/success/failed/refunded and only needs an adapter wired to
# whichever provider you contract with in Senegal (Wave, Orange Money, or a
# PSP aggregator such as PayDunya/CinetPay that bundles both). Until these
# are set, students can only be marked "paid" manually by an admin.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Video conferencing with recording (sections 10-11) — NOT YET CONFIGURED.
# Live sessions currently use auto-generated https://meet.jit.si links (free,
# no key required, no recording). To enable recording + a "cours enregistrés"
# library, configure a provider that supports server-side recording (e.g.
# Daily.co, or Jitsi self-hosted with Jibri) and set:
# ---------------------------------------------------------------------------
VIDEO_PROVIDER_KEY=
VIDEO_PROVIDER_SECRET=

# ---------------------------------------------------------------------------
# AI assistant (sections 17-23) — WORKS AS SOON AS YOU SET THIS. Powers the
# 🤖 Assistant IA available to every role (lib/actions/assistant.ts). Each
# role only ever sees a summary of its own RLS-scoped data, built server-side
# before the call; the assistant never executes actions itself, only drafts
# suggestions. Get a key at https://console.anthropic.com.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Transactional email (OTP phone signup requires a separate SMS provider,
# not listed here — not implemented; see report) — NOT YET CONFIGURED.
# Supabase's built-in email sender works out of the box for auth emails
# (confirmation, invites) but is rate-limited; set an SMTP/email API provider
# in Supabase Dashboard > Authentication > Email for production volume.
# ---------------------------------------------------------------------------
EMAIL_API_KEY=
